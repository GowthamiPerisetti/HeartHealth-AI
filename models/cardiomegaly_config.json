{
  "architecture": "DenseNet121",
  "num_classes": 2,
  "input_size": [
    3,
    224,
    224
  ],
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "target_labels": {
    "0": "No Finding (No Cardiomegaly)",
    "1": "Cardiomegaly Positive"
  },
  "training_device": "cuda",
  "batch_size": 32,
  "epochs": 6,
  "initial_lr": 0.0001,
  "optimizer": "AdamW"
}